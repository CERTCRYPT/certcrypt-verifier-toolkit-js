# Deployment profile for running this verifier against a CERTCRYPT-compatible
# deployment you operate.
#
# WHAT THIS IS FOR
#
# The toolkit is verification infrastructure, not a client for one system.
# `verify()` accepts any `SystemDomainConfig`, the type is exported, and the CLI
# takes `--test-config <path>`. So these variables are how you point the harness
# at a deployment you control: your own MPT issuance, your own settlement
# account, your own rules domain.
#
#   cp .env.example .env.local
#   $EDITOR .env.local
#   set -a; . ./.env.local; set +a
#
# NOT SECRETS. Every value here is public on the ledger, and no signing key
# appears — this toolkit verifies and cannot produce a signature. They are kept
# out of git because a deployment profile belongs to whoever operates that
# deployment, not to the verifier: supply it through the environment or
# `--test-config`, and never commit it.
#
# Verifying under anything other than the published production profile yields
# `production_verification: false`. That is not a limitation to work around: it is
# the flag that stops one system's result from being presented as another's.

# Your system domain's identifier.
CERTCRYPT_VERIFY_SYSTEM_ID=your-system-id

# SHA3-256 of your system domain's root key set.
CERTCRYPT_VERIFY_SYSTEM_ROOT_FINGERPRINT=

# Comma-separated. The rules domains this configuration accepts.
CERTCRYPT_VERIFY_RULES_VERSIONS=your-org/your-version

# The `foundation_statement_id` of your system domain's bootstrap statement,
# exactly as your registry entry declares it. A statement carrying any other id is
# rejected even when its fingerprint and quorum verify.
CERTCRYPT_VERIFY_FOUNDATION_STATEMENT_ID=

# SHA3-256 (lowercase hex) of the canonical unsigned payload of that statement
# (system-foundation/1 Section 9), exactly as your registry entry declares it. A
# statement with any other signed content is rejected, even one your bootstrap
# quorum signed.
CERTCRYPT_VERIFY_FOUNDATION_PAYLOAD_DIGEST=

# Comma-separated. The subject profiles your rules domain admits. A subject — or
# a collection leaf — declaring any other profile fails closed.
CERTCRYPT_VERIFY_SUBJECT_PROFILES=subject.binary/1,subject.text/1,subject.email/1,subject.collection/1,subject.ai-decision/1,subject.context-snapshot/1

# The composite signature profile your rules domain fixes for certificate,
# Level-1 binding and proof signatures. A signature declaring any other profile
# fails closed.
CERTCRYPT_VERIFY_SIGNATURE_PROFILE=certcrypt-composite-p256-mldsa65-v1

# The settlement profile your rules domain selects.
CERTCRYPT_VERIFY_SETTLEMENT_PROFILE_ID=settlement.aggregated.xrpl/1

# Comma-separated `<rules_version>=<subtree_root>` pairs: the corpus commitment
# this configuration certifies for each rules domain it accepts. REQUIRED — a
# profile that omitted it would be a verifier configured to accept ANY corpus as
# the rules text, which rules-domain/1 §13.3.1 forbids, so `getEnvConfig()`
# throws rather than defaulting.
#
# The value is not invented: it is the certified subtree root your rules domain
# publishes for that version. Every `CERTCRYPT_VERIFY_RULES_VERSIONS` entry you
# expect to verify under needs a pair here, or verification fails closed on it
# (which is the V042 case, and correct).
CERTCRYPT_VERIFY_RULES_CORPUS_ROOTS=your-org/your-version=<subtree_root>

# XRPL has no chain id. This is a namespaced identity built from the network id;
# it is compared for equality and never parsed. Its only job is to differ between
# networks, so material settled on one cannot pass as material from another. Use
# the value YOUR deployment settles under.
CERTCRYPT_VERIFY_XRPL_CHAIN_ID=your-chain-id

# Your MPTokenIssuanceID (48 hex characters). Its last 20 bytes ARE the issuer's
# AccountID, so naming the issuance names the issuer.
CERTCRYPT_VERIFY_XRPL_MPT_ISSUANCE_ID=

# The account your settlements debit. NEVER an issuer's own: settling from one
# aggregate account is what keeps the ledger from revealing which issuer
# certified. A verifier rejects a settlement debited from anywhere else.
CERTCRYPT_VERIFY_XRPL_SETTLEMENT_ACCOUNT=

# The capacity-commitment TTL your rules domain declares, in seconds. This one IS
# a rules-domain parameter — different domains legitimately choose different
# values — so it is configurable. Defaults to 86400 (24h).
# CERTCRYPT_VERIFY_COMMITMENT_TTL_SECONDS=86400
